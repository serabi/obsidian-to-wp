{
	"name": "sync-for-wordpress",
	"version": "0.1.0",
	"description": "Publish notes to WordPress as editable block editor posts",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/*.test.ts\""
	},
	"keywords": [
		"obsidian",
		"wordpress",
		"gutenberg",
		"publishing"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"obsidian": "1.11.4",
		"tslib": "2.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"obsidian": "$obsidian"
		}
	},
	"dependencies": {
		"markdown-it": "15.0.3",
		"markdown-it-footnote": "4.0.0",
		"markdown-it-mark": "4.0.0"
	}
}
